{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-control-regex": "off",
    "unicorn/no-array-sort": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["dist/**"]
}
