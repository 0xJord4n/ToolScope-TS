{
  "name": "toolscope-ts",
  "version": "1.0.0",
  "description": "Semantic tool retrieval for TypeScript agents, powered by Bun",
  "keywords": [
    "ai",
    "bun",
    "langgraph",
    "mcp",
    "semantic-search",
    "tool-retrieval",
    "typescript",
    "vercel-ai"
  ],
  "homepage": "https://github.com/0xJord4n/ToolScope-TS#readme",
  "bugs": {
    "url": "https://github.com/0xJord4n/ToolScope-TS/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xJord4n/ToolScope-TS.git"
  },
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "files": [
    "dist",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters/vercel-ai": {
      "types": "./dist/adapters/vercel-ai.d.ts",
      "import": "./dist/adapters/vercel-ai.js",
      "default": "./dist/adapters/vercel-ai.js"
    },
    "./adapters/langgraph": {
      "types": "./dist/adapters/langgraph.d.ts",
      "import": "./dist/adapters/langgraph.js",
      "default": "./dist/adapters/langgraph.js"
    },
    "./adapters/mcp": {
      "types": "./dist/adapters/mcp.d.ts",
      "import": "./dist/adapters/mcp.js",
      "default": "./dist/adapters/mcp.js"
    },
    "./backends/sqlite": {
      "types": "./dist/backends/sqlite.d.ts",
      "import": "./dist/backends/sqlite.js",
      "default": "./dist/backends/sqlite.js"
    },
    "./paper": {
      "types": "./dist/paper/index.d.ts",
      "import": "./dist/paper/index.js",
      "default": "./dist/paper/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts ./src/adapters/vercel-ai.ts ./src/adapters/langgraph.ts ./src/adapters/mcp.ts ./src/backends/sqlite.ts ./src/paper/index.ts --outdir ./dist --target bun --format esm --external @langchain/core --external @langchain/langgraph --external ai --external zod && tsc -p tsconfig.build.json",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src tests examples",
    "lint:fix": "oxlint --fix src tests examples",
    "package:check": "publint && npm pack --dry-run",
    "prepublishOnly": "bun run check",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.14",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/bun": "latest",
    "ai": "^7.0.93",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "publint": "0.3.18",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0",
    "@langchain/langgraph": ">=0.2.0",
    "@modelcontextprotocol/sdk": ">=1.20.0",
    "ai": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  }
}
